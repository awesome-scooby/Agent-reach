{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "42rem",
			"wideSize": "64rem"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"defaultDuotone": false,
			"palette": [
				{
					"slug": "paper",
					"name": "Background",
					"color": "#FFFFFF"
				},
				{
					"slug": "surface",
					"name": "Tile grey",
					"color": "#F5F5F7"
				},
				{
					"slug": "ink",
					"name": "Text",
					"color": "#1D1D1F"
				},
				{
					"slug": "muted",
					"name": "Secondary text",
					"color": "#5E5E63"
				},
				{
					"slug": "primary",
					"name": "Primary (deep teal)",
					"color": "#1F6A5A"
				},
				{
					"slug": "primary-deep",
					"name": "Headings",
					"color": "#1D1D1F"
				},
				{
					"slug": "tint",
					"name": "Band grey",
					"color": "#F5F5F7"
				},
				{
					"slug": "accent",
					"name": "Draft marker / focus",
					"color": "#9A5B13"
				},
				{
					"slug": "line",
					"name": "Lines",
					"color": "#D2D2D7"
				},
				{
					"slug": "tile-a",
					"name": "Tile colour A",
					"color": "#F5F5F7"
				},
				{
					"slug": "tile-b",
					"name": "Tile colour B",
					"color": "#F5F5F7"
				},
				{
					"slug": "tile-c",
					"name": "Tile colour C",
					"color": "#F5F5F7"
				},
				{
					"slug": "tile-d",
					"name": "Tile colour D",
					"color": "#F5F5F7"
				}
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontFamilies": [
				{
					"slug": "sans",
					"name": "Inter (Clarity)",
					"fontFamily": "Inter, -apple-system, BlinkMacSystemFont, \"Segoe UI\", Roboto, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Inter",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/inter-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "body",
					"name": "Atkinson Hyperlegible (body)",
					"fontFamily": "\"Atkinson Hyperlegible\", system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Atkinson Hyperlegible",
							"fontWeight": "400",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible-latin-400-normal.woff2"
							]
						},
						{
							"fontFamily": "Atkinson Hyperlegible",
							"fontWeight": "700",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/atkinson-hyperlegible-latin-700-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "heading",
					"name": "Newsreader (headings)",
					"fontFamily": "Newsreader, Georgia, serif",
					"fontFace": [
						{
							"fontFamily": "Newsreader",
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/newsreader-latin-wght-normal.woff2"
							]
						}
					]
				},
				{
					"slug": "alt",
					"name": "Lexend (alternative style)",
					"fontFamily": "Lexend, system-ui, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Lexend",
							"fontWeight": "100 900",
							"fontStyle": "normal",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/lexend-latin-wght-normal.woff2"
							]
						}
					]
				}
			],
			"fontSizes": [
				{
					"slug": "small",
					"name": "Small",
					"size": "0.9375rem"
				},
				{
					"slug": "medium",
					"name": "Body",
					"size": "1.0625rem"
				},
				{
					"slug": "large",
					"name": "Lead",
					"size": "1.3125rem",
					"fluid": {
						"min": "1.1875rem",
						"max": "1.5rem"
					}
				},
				{
					"slug": "x-large",
					"name": "Section heading",
					"size": "2.5rem",
					"fluid": {
						"min": "1.875rem",
						"max": "3rem"
					}
				},
				{
					"slug": "xx-large",
					"name": "Hero heading",
					"size": "4rem",
					"fluid": {
						"min": "2.5rem",
						"max": "4.5rem"
					}
				}
			]
		},
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{
					"slug": "20",
					"name": "XS",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "S",
					"size": "1rem"
				},
				{
					"slug": "40",
					"name": "M",
					"size": "1.5rem"
				},
				{
					"slug": "50",
					"name": "L",
					"size": "clamp(2rem, 5vw, 3rem)"
				},
				{
					"slug": "60",
					"name": "XL",
					"size": "clamp(2.5rem, 8vw, 5rem)"
				}
			]
		},
		"custom": {
			"radius": {
				"leaf": "1.5rem",
				"soft": "1.125rem",
				"tile": "1.5rem"
			},
			"font": {
				"heading": "var(--wp--preset--font-family--sans)"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--sans)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.53",
			"letterSpacing": "-0.01em"
		},
		"spacing": {
			"blockGap": "1.25rem",
			"padding": {
				"left": "max(1rem, 5vw)",
				"right": "max(1rem, 5vw)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "650",
					"lineHeight": "1.08",
					"letterSpacing": "-0.025em"
				},
				"color": {
					"text": "var(--wp--preset--color--primary-deep)"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--xx-large)",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--x-large)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--primary)"
				},
				"typography": {
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--primary)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px",
						"offset": "2px"
					}
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "#FFFFFF"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontWeight": "500",
					"fontSize": "1.0625rem"
				},
				"border": {
					"radius": "980px"
				},
				"spacing": {
					"padding": {
						"top": "0.75rem",
						"bottom": "0.75rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "#17564A",
						"text": "#FFFFFF"
					}
				},
				":focus": {
					"outline": {
						"color": "var(--wp--preset--color--accent)",
						"style": "solid",
						"width": "3px",
						"offset": "3px"
					}
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--sans)",
					"fontSize": "1.0625rem",
					"fontWeight": "600",
					"letterSpacing": "-0.01em"
				},
				"elements": {
					"link": {
						"typography": {
							"textDecoration": "none"
						},
						"color": {
							"text": "var(--wp--preset--color--ink)"
						}
					}
				}
			},
			"core/navigation": {
				"typography": {
					"fontSize": "0.9375rem"
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--line)"
				}
			},
			"core/table": {
				"border": {
					"color": "var(--wp--preset--color--line)"
				}
			}
		}
	},
	"templateParts": [
		{
			"name": "header",
			"title": "Header",
			"area": "header"
		},
		{
			"name": "footer",
			"title": "Footer",
			"area": "footer"
		}
	],
	"customTemplates": [
		{
			"name": "page-no-title",
			"title": "Page without visible title",
			"postTypes": [
				"page"
			]
		}
	]
}